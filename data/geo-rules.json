      "IN": "www.amazon.in", "SG": "www.amazon.sg", "AU": "www.amazon.com.au",
      "AE": "www.amazon.ae", "SA": "www.amazon.sa", "EG": "www.amazon.eg",
      "QA": "www.amazon.ae", "KW": "www.amazon.ae", "BH": "www.amazon.ae",
      "OM": "www.amazon.ae", "JO": "www.amazon.ae"
    },
