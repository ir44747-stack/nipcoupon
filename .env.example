# Copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored AND excluded from the Vercel upload.
# On Vercel, set these in  Project → Settings → Environment Variables
# (Production + Preview), then redeploy. Nothing here belongs in source code.
#
# Rotate any value that has ever been pasted into a chat window.

# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────
# Used to build canonical URLs (/coupon/<id>) and sitemap entries.
SITE_URL=https://nipcoupon.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# OFFER PROVIDER  (Req 2 — the authorised endpoint the daily sync reads from)
# ─────────────────────────────────────────────────────────────────────────────
# The ONE endpoint scripts/sync-offers.js is allowed to read offers from.
OFFERS_API_URL=
# Credential for that endpoint. Sent as `Authorization: Bearer <key>`.
OFFERS_API_KEY=
# Non-Bearer providers: override the header name / style.
#   header: X-Api-Key      style: raw   →  X-Api-Key: <key>
# OFFERS_API_HEADER_NAME=Authorization
# OFFERS_API_HEADER_STYLE=Bearer        # Bearer | raw

# ─────────────────────────────────────────────────────────────────────────────
# LINK GUARD  (Req 3 — which hosts may ever appear in a published link)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated host allowlist. EMPTY = use the built-in default list
# (sovrn.co + the major affiliate networks). Only allowlisted hosts are
# published; everything else is dropped before it reaches the catalogue.
# LINK_GUARD_ALLOWLIST=sovrn.co,shareasale.com

# ─────────────────────────────────────────────────────────────────────────────
# SOVRN COMMERCE
# ─────────────────────────────────────────────────────────────────────────────
# Site key. Stored in data/stores.json ONLY as the placeholder ${SOVRN_API_KEY},
# which is expanded server-side at request time. Changing this one variable
# re-points all 70 store links.
SOVRN_API_KEY=
# Genuine secret — used for Sovrn's coupon APIs. Never put this in a URL.
SOVRN_SECRET_KEY=
# SOVRN_LINK_BASE=https://sovrn.co
# SOVRN_CUID=nipcoupon

# ─────────────────────────────────────────────────────────────────────────────
# CJ AFFILIATE  (suspended — retained, unused)
# ─────────────────────────────────────────────────────────────────────────────
# CJ_ACCESS_TOKEN=
# CJ_PUBLISHER_ID=8058000
# CJ_PROPERTY_ID=101873115

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# General-purpose remote deals feed (api/_data.js)
# DEALS_FEED_URL=
# FEED_TOKEN=
# IndexNow — instant push to Bing, Yandex, Seznam, Naver and Yep (api/cron.js).
# Create a 32-hex-character key, host it at https://nipcoupon.vercel.app/<key>.txt
# containing nothing but the key itself, then set it here.
# INDEXNOW_KEY=
#
# Bing Webmaster Tools — batch URL submission (api/cron.js).
# From Bing Webmaster Tools → Settings → API access.
# BING_API_KEY=
#
# Shared secret for the /api/cron endpoint. Set this: without it the endpoint
# is open to anyone who knows the URL. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when its scheduler calls the cron.
# CRON_SECRET=
#
# NOTE ON GOOGLE — there is nothing to configure, and that is not an oversight.
# Google retired the sitemap ping endpoint in 2023 (it now returns 404), and its
# Indexing API only accepts JobPosting and BroadcastEvent pages. For ordinary
# pages the supported discovery routes are the "Sitemap:" line in robots.txt
# (already there) and the Search Console. Push indexing for Google is IndexNow
# via Bing's participation, not a Google endpoint.
