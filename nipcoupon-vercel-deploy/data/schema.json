{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nipcoupon.vercel.app/data/schema.json",
  "title": "NipCoupon deal data",
  "description": "Editor validation for the modular data files in /data. Add $ref pointers in your editor settings, or run `node scripts/validate.js`.",
  "definitions": {
    "region": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2,}$", "examples": ["GLOBAL", "QA", "AE"] },
        "name": { "type": "string", "examples": ["Qatar"] },
        "flag": { "type": "string", "description": "Flag emoji shown in the country selector" },
        "default": { "type": "boolean", "description": "Exactly one region should be the fallback (GLOBAL)" }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "examples": ["#10b981", "#fff"]
    },
    "store": {
      "type": "object",
      "required": ["id", "name", "color", "fg"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Slug used by coupons.storeId", "examples": ["amazon", "booking-com"] },
        "name": { "type": "string", "description": "Display name", "examples": ["Amazon"] },
        "abbr": { "type": "string", "maxLength": 4, "description": "1-4 chars in the logo tile (omit if glyph is set)" },
        "color": { "$ref": "#/definitions/hexColor", "description": "Tile background" },
        "fg": { "$ref": "#/definitions/hexColor", "description": "Tile text colour" },
        "glyph": { "type": "string", "description": "Optional inline SVG replacing abbr (e.g. the Apple logo)" },
        "url": { "type": "string", "format": "uri", "description": "Destination for Get Code / Get Deal" },
        "affiliateTag": { "type": "string", "description": "Raw query string appended to this store's links, e.g. \"tag=your-id-20\"" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Markets this brand operates in — see data/regions.json",
          "examples": [["GLOBAL"], ["QA", "AE", "SA"]]
        },
        "originalUrl": {
          "type": "string",
          "format": "uri",
          "description": "Un-monetised destination. Used as the fallback when `url` holds an unresolved ${…} placeholder."
        },
        "affiliateSource": {
          "type": "string",
          "description": "Which network produced the link (e.g. \"sovrn\")",
          "examples": ["sovrn", "cj"]
        },
        "sovrnVerified": {
          "type": "boolean",
          "description": "True when the Sovrn wrapper was confirmed to redirect correctly"
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["id", "name", "icon"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "examples": ["tech", "fashion"] },
        "name": { "type": "string", "examples": ["Tech & Electronics"] },
        "icon": { "type": "string", "enum": ["cpu", "shirt", "plane", "game", "code"], "description": "Key from the ICONS map in index.html" },
        "blurb": { "type": "string" }
      }
    },
    "coupon": {
      "type": "object",
      "required": ["id", "storeId", "categoryId", "type", "badge", "value", "title", "expires"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "examples": ["c1"] },
        "storeId": { "type": "string", "description": "Must match a store id" },
        "categoryId": { "type": "string", "description": "Must match a category id" },
        "type": { "enum": ["code", "deal"], "description": "\"code\" needs a code; \"deal\" applies automatically" },
        "code": { "type": "string", "description": "Promo code, required when type is \"code\"", "examples": ["SNIPE30"] },
        "badge": { "type": "string", "description": "Short label on the discount badge", "examples": ["30% OFF", "FREE DELIVERY"] },
        "value": { "type": "number", "minimum": 0, "description": "Numeric discount used by the \"highest discount\" sort" },
        "title": { "type": "string", "description": "Offer headline shown on the card" },
        "verifiedHoursAgo": { "type": "number", "minimum": 0, "description": "Drives the \"Verified Today / Xh ago\" label" },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date, YYYY-MM-DD" },
        "uses": { "type": "number", "minimum": 0, "description": "Popularity counter" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "addedDaysAgo": { "type": "number", "minimum": 0, "description": "Used by the \"newest\" sort" },
        "hot": { "type": "boolean", "description": "Adds the HOT ribbon" },
        "terms": { "type": "array", "items": { "type": "string" } },
        "landingUrl": { "type": "string", "format": "uri", "description": "Optional deep link; overrides the store url for this coupon" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Markets this deal is valid in. A coupon is shown when regions contains the shopper's region OR \"GLOBAL\".",
          "examples": [["GLOBAL"], ["AE", "SA", "QA", "KW", "BH", "OM"]]
        },
        "canonicalPath": { "type": "string", "description": "Site-relative SEO path, e.g. \"/coupon/c1\"" },
        "canonicalUrl":  { "type": "string", "format": "uri", "description": "Absolute canonical URL; always on our domain, never the provider's" },
        "categoryPath":  { "type": "string", "description": "Grouping path, e.g. \"/category/tech\"" },
        "source":        { "type": "string", "description": "Where the record came from", "examples": ["local", "provider", "feed"] },
        "active":              { "type": "boolean", "description": "Set false by scripts/link-health.js after repeated probe failures" },
        "lastChecked":         { "type": "string", "description": "ISO timestamp of the last link-health probe" },
        "healthNote":          { "type": "string", "description": "Why a coupon was deactivated" },
        "consecutiveFailures": { "type": "number", "minimum": 0, "description": "Probe failures in a row; 2 triggers deactivation" },
        "linkVerdict":         { "type": "string", "enum": ["ok", "blocked", "unknown", "unchecked"], "description": "Result of the last link-guard validation" },
        "linkStatus":          { "type": "number", "description": "HTTP status observed by the last probe" },
        "linkCheckedAt":       { "type": "string", "description": "ISO timestamp of the last link-guard validation" },
        "verified":            { "type": "boolean", "description": "Provider-reported verification; false is rejected by link-guard" }
      }
    }
  },
  "type": "object",
  "properties": {
    "stores": { "type": "array", "items": { "$ref": "#/definitions/store" } },
    "categories": { "type": "array", "items": { "$ref": "#/definitions/category" } },
    "coupons": { "type": "array", "items": { "$ref": "#/definitions/coupon" } },
    "regions": { "type": "array", "items": { "$ref": "#/definitions/region" } },
    "config": {
      "type": "object",
      "properties": {
        "brand": { "type": "object" },
        "attribution": { "type": "object", "description": "Query params appended to every outbound link" },
        "pageSize": { "type": "number", "minimum": 1 },
        "feed": { "type": "object" }
      }
    }
  }
}
